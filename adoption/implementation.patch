new file mode 100644
index 0000000..2b5728d
--- /dev/null
+++ b/tests/php-adoption.py
@@ -0,0 +1,25 @@
+"""Isolated PHP contract cases; php -n, no credentials, copied fixture only.
+No provider path can run: no configuration/key, no cURL extension loaded.
+"""
+from pathlib import Path
+import tempfile,shutil,subprocess,json,os,sys
+r=Path(__file__).resolve().parents[1]
+php=shutil.which('php')
+if not php:
+ print(json.dumps({'status':'BLOCKED','reason':'PHP executable unavailable','executed_cases':0}));sys.exit(2)
+results=[]
+with tempfile.TemporaryDirectory(prefix='adopt-php-') as tmp:
+ d=Path(tmp)/'isolated'/'support';d.mkdir(parents=True)
+ for n in ['ask.php','ai-config.php']:
+  shutil.copyfile(r/'integrations/hostinger-runtime/intellignce-support'/n,d/n)
+ for n in ['knowledge.json','sales-policy.txt']:
+  shutil.copyfile(r/'public/intellignce-support'/n,d/n)
+ for p in d.glob('*.php'):
+  subprocess.run([php,'-n','-l',str(p)],check=True,capture_output=True)
+ for method,origin,expected in [('GET','',200),('PUT','',405),('POST','https://invalid.example',403),('POST','https://hadi.intellignce.net',503)]:
+  wrapper=d/'case.php';wrapper.write_text('<?php $_SERVER='+"['REQUEST_METHOD'=>"+json.dumps(method)+",'HTTP_ORIGIN'=>"+json.dumps(origin)+"];register_shutdown_function(function(){echo '\\nHTTP_STATUS='.http_response_code();});require __DIR__.'/ask.php';")
+  p=subprocess.run([php,'-n',str(wrapper)],env={'PATH':os.environ.get('PATH','')},capture_output=True,text=True,check=True)
+  body,status=p.stdout.rsplit('\\nHTTP_STATUS=',1);response=json.loads(body);assert int(status)==expected,(method,p.stdout)
+  if method=='GET':assert response['available'] is False and response['code']=='CONFIG_MISSING'
+  results.append({'method':method,'origin':origin,'expected_status':expected,'status':'PASS'})
+print(json.dumps({'scope':'fixture only; no live configuration/provider operations','results':results},indent=2))
