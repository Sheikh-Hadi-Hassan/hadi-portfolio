+"""Offline adoption checks. PHP cases are explicitly blocked without PHP."""
+from pathlib import Path
+import subprocess,hashlib,json,re,sys,shutil,tempfile,zipfile
+r=Path(__file__).resolve().parents[1]; results=[]
+def check(name,fn):
+ fn();results.append({'test':name,'status':'PASS'})
+def run(args):subprocess.run(args,cwd=r,check=True,stdout=subprocess.DEVNULL)
+check('adopted fingerprints and archive separation',lambda:run([sys.executable,'scripts/verify-adoption.py']))
+def deterministic():
+ paths=['public/style.css','public/appbar.css']+['public/intellignce-support/'+n for n in ['widget-v9.js','widget-v4.1.js','widget-v5.js','widget-v6.js','widget-v7.js','widget-v8.js','widget.js']]
+ before={p:(r/p).read_bytes() for p in paths}
+ run([sys.executable,'scripts/generate-adopted-runtime.py']);run([sys.executable,'scripts/generate-adopted-runtime.py'])
+ assert before=={p:(r/p).read_bytes() for p in paths}
+check('generation idempotent across two runs',deterministic)
+def navigation():
+ old=subprocess.check_output(['git','show','66e3e1df67331a92b2966dcab9724e70c8f11d90:src/components/navigation.html'],cwd=r).decode()
+ expected,n=re.subn(r'<a\b[^>]*class="[^"]*\bdock-contact-enquiry\b[^"]*"[^>]*>.*?</a>','',old,flags=re.S)
+ assert n==1 and expected==(r/'src/components/navigation.html').read_text()
+check('navigation changes only identified Enquire anchor; other CTAs byte-preserved',navigation)
+check('widget syntax',lambda:run(['node','--check','public/intellignce-support/widget-v9.js']))
+check('hero preserved',lambda:run([sys.executable,'scripts/verify-hero-lock.py']))
+def booking():
+ for p in ['integrations/calendar-v8/Code.gs','integrations/calendar-v8/appsscript.json','src/styles/viewport-frames.css','package.json','package-lock.json']:
+  assert (r/p).read_bytes()==subprocess.check_output(['git','show','66e3e1df67331a92b2966dcab9724e70c8f11d90:'+p],cwd=r)
+check('booking, viewport and dependency inputs unchanged',booking)
+if shutil.which('php'):
+ for p in [r/'integrations/hostinger-runtime/intellignce-support/ask.php',r/'recovery/non-web/ask(1).php']:
+  check('PHP syntax '+p.name,lambda p=p:run(['php','-l',str(p)]))
+else:results.append({'test':'PHP syntax and isolated configuration/failure execution','status':'BLOCKED','reason':'PHP executable unavailable; no PHP execution or provider requests attempted'})
+print(json.dumps({'scope':'offline source checks only; no Next/hydration/provider certification','results':results},indent=2))
