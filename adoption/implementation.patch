+"""Verify adopted bytes and private/archive separation without provider calls."""
+from pathlib import Path
+import hashlib,json,subprocess
+r=Path(__file__).resolve().parents[1]
+h=lambda p:hashlib.sha256((r/p).read_bytes()).hexdigest()
+manifest=json.loads((r/'ADOPTION-MANIFEST.json').read_text())
+for p,want in manifest['adopted_source_sha256'].items():assert h(p)==want,p
+original=subprocess.check_output(['git','show',manifest['original_source_commit']+':src/styles/site.css'],cwd=r)
+assert (r/'src/styles/site.css').read_bytes()==original,'Original site.css changed'
+assert (r/'public/style.css').read_bytes()==original+b'\n'+(r/'src/styles/appbar.css').read_bytes()
+assert 'dock-contact-enquiry' not in (r/'src/components/navigation.html').read_text()
+for name in ['widget-v9.js','widget-v4.1.js','widget-v5.js','widget-v6.js','widget-v7.js','widget-v8.js','widget.js']:
+ assert h('public/intellignce-support/'+name)==manifest['widget_sha256']
+for directory in ['public','out','build','integrations/hostinger-runtime']:
+ for p in (r/directory).rglob('*'):
+  if p.is_file():assert p.name not in {'ask(1).php','private-config.php','hadi-leads-config.php','hadi-ai-config.php'} and not p.name.startswith('.env'),str(p)
