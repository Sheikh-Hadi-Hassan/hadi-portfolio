Options -Indexes
DirectoryIndex index.html
AddType application/javascript .js .mjs
AddType text/css .css
AddType image/svg+xml .svg
ErrorDocument 404 /404.html
<FilesMatch "(?i)^(private-config\.php|hadi-ai-config\.php|hadi-leads-config\.php|\.env.*)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), microphone=(self)"
  Header always set Content-Security-Policy "upgrade-insecure-requests; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"

  <FilesMatch "(?i)^(widget.*\.js|index\.html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
