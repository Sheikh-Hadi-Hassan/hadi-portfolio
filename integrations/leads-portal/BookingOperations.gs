// Owner-only RPC. No doPost action or public booking key can invoke these operations.
function boError_(code){const e=Error(code);e.code=code;return e}
function boConfig_(){const p=PropertiesService.getScriptProperties();if(p.getProperty('BOOKING_OPERATIONS_ENABLED')!=='true')throw boError_('BOOKING_OPERATIONS_DISABLED');let c;try{c=JSON.parse(p.getProperty('BOOKING_OPERATIONS_POLICY')||'null')}catch(e){}if(!c||typeof c!=='object'||Array.isArray(c)||Object.keys(c).some(k=>!['calendarId','timezone','duration','noticeMinutes','horizon','startHour','endHour','days'].includes(k))||typeof c.calendarId!=='string'||!c.calendarId||c.calendarId.length>256||/[\s/\\?#]/.test(c.calendarId)||typeof c.timezone!=='string'||!Number.isInteger(c.duration)||c.duration<15||c.duration>120||!Number.isInteger(c.noticeMinutes)||c.noticeMinutes<0||c.noticeMinutes>1440||!Number.isInteger(c.horizon)||c.horizon<1||c.horizon>60||!Number.isInteger(c.startHour)||!Number.isInteger(c.endHour)||c.startHour<0||c.endHour>24||c.endHour<=c.startHour||!Array.isArray(c.days)||!c.days.length||c.days.length>7||new Set(c.days).size!==c.days.length||c.days.some(d=>!Number.isInteger(d)||d<0||d>6))throw boError_('BOOKING_POLICY_UNVERIFIED');try{Utilities.formatDate(new Date(),c.timezone,'yyyy-MM-dd')}catch(e){throw boError_('BOOKING_POLICY_UNVERIFIED')}if(typeof SETTINGS==='undefined'||typeof save_!=='function'||typeof HEADERS==='undefined'||typeof meeting_!=='function'||typeof sheet_!=='function'||c.calendarId!==SETTINGS.calendar||['timezone','duration','noticeMinutes','horizon','startHour','endHour','days'].some(k=>JSON.stringify(c[k])!==JSON.stringify(SETTINGS[k]))||sheet_().getParent().getId()!==SpreadsheetApp.getActiveSpreadsheet().getId())throw boError_('BOOKING_SHARED_WRITER_UNVERIFIED');return c}
function boOwner_(token){const actor=ccGuard_(token,true);boConfig_();return actor}
function openBookingOperations(){const actor=ccActor_();if(actor.role!=='owner')throw boError_('ADMIN_FORBIDDEN');SpreadsheetApp.getUi().showModelessDialog(HtmlService.createHtmlOutputFromFile('BookingOperations').setWidth(900).setHeight(750),'Booking operations')}
function getBookingOperationsSession(){const s=ccToken_();if(s.actor.role!=='owner')throw boError_('ADMIN_FORBIDDEN');let ready=false;try{boConfig_();ready=true}catch(e){}return {...s,enabled:ready,recent:ready?boJournal_().rows.filter(r=>r[5]===s.actor.email).slice(-20).reverse().map(r=>({operationId:r[0],reference:r[1],requestType:r[2],state:r[4]})):[],notice:ready?'Private owner operations. Calendar notifications are requested only after confirmation; delivery is not proven.':'Disabled until hosting/Google identity, policy, permissions and isolated acceptance are approved.'}}
function boHash_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s).map(b=>(b&255).toString(16).padStart(2,'0')).join('')}
function boUUID_(s){return typeof s==='string'&&/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(s)}
function boLead_(reference){if(typeof reference!=='string'||!/^HADI-[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(reference))throw boError_('BOOKING_REFERENCE_INVALID');const sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Leads');if(!sheet)throw boError_('BOOKING_STORAGE_UNAVAILABLE');if(JSON.stringify(sheet.getRange(1,1,1,18).getValues()[0])!==JSON.stringify(HEADERS))throw boError_('BOOKING_SCHEMA_UNVERIFIED');const found=sheet.getRange('A:A').createTextFinder(reference).matchEntireCell(true).findNext();if(!found||found.getRow()<2)throw boError_('BOOKING_NOT_FOUND');const row=found.getRow(),values=sheet.getRange(row,1,1,18).getValues()[0],eventId='hadi'+reference.slice(5).replace(/-/g,'').toLowerCase();if(values[0]!==reference||values[12]!==eventId||!Number.isFinite(Date.parse(values[11])))throw boError_('BOOKING_IDENTITY_UNVERIFIED');return {sheet,row,values,eventId}}
function boCalendar_(config,method,id,body,etag,query){if(method==='get')query={...(query||{}),fields:id?'id,status,etag,start,end,extendedProperties,conferenceData,hangoutLink':'items(id,status,transparency),nextPageToken'};const base='https://www.googleapis.com/calendar/v3/calendars/'+encodeURIComponent(config.calendarId)+'/events',url=base+(id?'/'+encodeURIComponent(id):'')+(query?'?'+Object.entries(query).map(([k,v])=>encodeURIComponent(k)+'='+encodeURIComponent(v)).join('&'):'');const headers={Authorization:'Bearer '+ScriptApp.getOAuthToken()};if(etag)headers['If-Match']=etag;const options={method,headers,muteHttpExceptions:true,followRedirects:false,validateHttpsCertificates:true};if(body){options.contentType='application/json';options.payload=JSON.stringify(body)}let response;try{response=UrlFetchApp.fetch(url,options)}catch(e){throw boError_('BOOKING_PROVIDER_OUTCOME_UNKNOWN')}const code=response.getResponseCode();if(code===412)throw boError_('BOOKING_VERSION_CONFLICT');if(code===404)throw boError_('BOOKING_EVENT_NOT_FOUND');if(code<200||code>=300)throw boError_(code===429?'BOOKING_PROVIDER_RATE_LIMITED':'BOOKING_PROVIDER_UNAVAILABLE');try{const data=JSON.parse(response.getContentText());if(!data||typeof data!=='object'||Array.isArray(data))throw Error();return data}catch(e){throw boError_('BOOKING_PROVIDER_RESPONSE_INVALID')}}
function boProof_(event,lead,config,start){const stamp=s=>typeof s==='string'&&/(Z|[+-]\d\d:\d\d)$/i.test(s)&&Number.isFinite(Date.parse(s));if(!event||event.id!==lead.eventId||event.status!=='confirmed'||event.extendedProperties?.private?.hadiReference!==lead.values[0]||typeof event.etag!=='string'||!event.etag||event.etag.length>256||/[\r\n]/.test(event.etag)||!stamp(start)||!stamp(event.start?.dateTime)||!stamp(event.end?.dateTime)||Date.parse(event.start.dateTime)!==Date.parse(start)||Date.parse(event.end.dateTime)-Date.parse(event.start.dateTime)!==config.duration*60000||event.start.timeZone&&event.start.timeZone!==config.timezone||event.end.timeZone&&event.end.timeZone!==config.timezone)throw boError_('BOOKING_IDENTITY_UNVERIFIED');return event}
function boSlot_(start,config){if(typeof start!=='string'||!/^\d{4}-\d\d-\d\dT\d\d:\d\d:00(?:\.000)?Z$/.test(start)||!Number.isFinite(Date.parse(start)))throw boError_('BOOKING_SLOT_INVALID');const date=new Date(start),t=+date,parts=Utilities.formatDate(date,config.timezone,'u,HH,mm').split(',').map(Number);if(t<Date.now()+config.noticeMinutes*60000||t>Date.now()+config.horizon*86400000||!config.days.includes(parts[0]%7)||parts[1]<config.startHour||parts[1]*60+parts[2]+config.duration>config.endHour*60||![0,30].includes(parts[2]))throw boError_('BOOKING_SLOT_INVALID')}
function boAvailable_(config,lead,start){boSlot_(start,config);const result=boCalendar_(config,'get','',null,null,{timeMin:start,timeMax:new Date(Date.parse(start)+config.duration*60000).toISOString(),singleEvents:true,showDeleted:false,maxResults:100});if(!Array.isArray(result.items)||result.nextPageToken)throw boError_('BOOKING_AVAILABILITY_UNVERIFIED');if(result.items.some(e=>!e||e.id!==lead.eventId&&e.status!=='cancelled'&&e.transparency!=='transparent'))throw boError_('BOOKING_SLOT_UNAVAILABLE')}
function previewBookingOperation(command,token){const actor=boOwner_(token);ccFields_(command,['reference','requestType','newStartUTC']);if(!['cancel','reschedule'].includes(command.requestType)||command.requestType==='cancel'&&command.newStartUTC)throw boError_('BOOKING_OPERATION_INVALID');const config=boConfig_(),lead=boLead_(command.reference),event=boProof_(boCalendar_(config,'get',lead.eventId),lead,config,lead.values[11]);if(command.requestType==='reschedule'){if(Date.parse(command.newStartUTC)===Date.parse(event.start.dateTime))throw boError_('BOOKING_NO_CHANGE');if(meeting_(event).meetingStatus!=='ready')throw boError_('BOOKING_MEET_UNVERIFIED');boAvailable_(config,lead,command.newStartUTC);}const preview={actor:actor.email,reference:command.reference,requestType:command.requestType,eventId:lead.eventId,oldStart:event.start.dateTime,etag:event.etag,newStartUTC:command.requestType==='reschedule'?command.newStartUTC:'',policyHash:boHash_(JSON.stringify(config)),created:Date.now()},previewToken=Utilities.getUuid()+Utilities.getUuid();CacheService.getUserCache().put('booking-preview:'+previewToken,JSON.stringify(preview),300);return {previewToken,reference:preview.reference,requestType:preview.requestType,currentStart:preview.oldStart,newStartUTC:preview.newStartUTC,timezone:config.timezone,duration:config.duration,expiresIn:300,notification:'Calendar update notifications will be requested once; delivery remains unverified.'}}
function boJournal_(){const sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('BookingOperations');if(!sheet)return {sheet:null,rows:[]};if(JSON.stringify(sheet.getRange(1,1,1,10).getValues()[0])!==JSON.stringify(['Operation ID','Reference','Type','Request hash','State','Actor','Created UTC','Event ID','Operation JSON','Result JSON']))throw boError_('BOOKING_JOURNAL_SCHEMA_INVALID');if(sheet.getLastRow()>1001)throw boError_('BOOKING_JOURNAL_ARCHIVE_REQUIRED');return {sheet,rows:sheet.getLastRow()<2?[]:sheet.getRange(2,1,sheet.getLastRow()-1,10).getValues()}}
function boPending_(op){return {ok:false,status:'reconciliation_required',code:'BOOKING_RECONCILIATION_REQUIRED',operationId:op.operationId,reference:op.reference,notification:'unknown',retry:'Read-only reconciliation only; do not submit a new operation.'}}
function boReconcile_(op,journal,row){const config=boConfig_();if(boHash_(JSON.stringify(config))!==op.policyHash)throw boError_('BOOKING_POLICY_CHANGED');const lead=boLead_(op.reference);let event;try{event=boCalendar_(config,'get',lead.eventId)}catch(e){return boPending_(op)}const target=op.requestType==='cancel'?'Cancelled':op.newStartUTC;let matched=false;if(op.requestType==='cancel')matched=event.id===lead.eventId&&event.status==='cancelled';else{try{boProof_(event,lead,config,target);matched=event.extendedProperties?.private?.hadiLifecycleOperation===op.operationId&&meeting_(event).meetingStatus==='ready'}catch(e){}}if(!matched)return boPending_(op);if(op.requestType==='reschedule'){try{boAvailable_(config,lead,op.newStartUTC)}catch(e){return {...boPending_(op),reason:'BOOKING_SLOT_CONFLICT_RECONCILIATION_REQUIRED'}}}const result={ok:true,status:op.requestType==='cancel'?'cancelled':'rescheduled',operationId:op.operationId,reference:op.reference,eventId:lead.eventId,start:op.requestType==='reschedule'?op.newStartUTC:'',notification:'unknown',verifiedAt:new Date().toISOString()};
 try{if(op.requestType==='reschedule')lead.sheet.getRange(lead.row,12).setValue(op.newStartUTC);lead.sheet.getRange(lead.row,3).setValue(op.requestType==='cancel'?'Cancelled':'Pending');if(op.requestType==='cancel')lead.sheet.getRange(lead.row,17).setValue('');lead.sheet.getRange(lead.row,15).setValue('Lifecycle notification requested; delivery unverified');SpreadsheetApp.flush();journal.getRange(row,5).setValue('completed');journal.getRange(row,10).setValue(JSON.stringify(result));SpreadsheetApp.flush();return result}catch(e){return boPending_(op)}}
function applyBookingOperation(command,token){const actor=boOwner_(token);ccFields_(command,['previewToken','operationId','confirm']);if(typeof command.previewToken!=='string'||command.previewToken.length!==72||!boUUID_(command.previewToken.slice(0,36))||!boUUID_(command.previewToken.slice(36))||!boUUID_(command.operationId)||command.confirm!==true)throw boError_('BOOKING_CONFIRMATION_REQUIRED');const hash=boHash_(JSON.stringify([actor.email,command.previewToken,command.operationId])),lock=LockService.getScriptLock();if(!lock.tryLock(1500))throw boError_('BOOKING_BUSY');try{let journal=boJournal_();const index=journal.rows.findIndex(r=>r[0]===command.operationId);if(index>=0){const record=journal.rows[index];if(record[3]!==hash||record[5]!==actor.email)throw boError_('BOOKING_OPERATION_MISMATCH');const op=JSON.parse(record[8]);if(record[4]==='completed')return {...JSON.parse(record[9]),replayed:true,historical:true};if(record[4]==='rejected')throw boError_(record[9]);return boReconcile_(op,journal.sheet,index+2)}const raw=CacheService.getUserCache().get('booking-preview:'+command.previewToken);if(!raw)throw boError_('BOOKING_PREVIEW_EXPIRED');const preview=JSON.parse(raw),config=boConfig_();if(preview.actor!==actor.email||Date.now()-preview.created>300000||preview.policyHash!==boHash_(JSON.stringify(config)))throw boError_('BOOKING_PREVIEW_EXPIRED');const lead=boLead_(preview.reference),event=boProof_(boCalendar_(config,'get',lead.eventId),lead,config,preview.oldStart);if(event.etag!==preview.etag)throw boError_('BOOKING_VERSION_CONFLICT');if(preview.requestType==='reschedule'){if(meeting_(event).meetingStatus!=='ready')throw boError_('BOOKING_MEET_UNVERIFIED');boAvailable_(config,lead,preview.newStartUTC);}const op={...preview,operationId:command.operationId};if(!journal.sheet){journal.sheet=SpreadsheetApp.getActiveSpreadsheet().insertSheet('BookingOperations');journal.sheet.appendRow(['Operation ID','Reference','Type','Request hash','State','Actor','Created UTC','Event ID','Operation JSON','Result JSON'])}if(journal.rows.length>=1000)throw boError_('BOOKING_JOURNAL_ARCHIVE_REQUIRED');journal.sheet.appendRow([op.operationId,op.reference,op.requestType,hash,'intent',actor.email,new Date().toISOString(),op.eventId,JSON.stringify(op),'']);SpreadsheetApp.flush();const row=journal.sheet.getLastRow(),body={extendedProperties:{private:{...(event.extendedProperties?.private||{}),hadiLifecycleOperation:op.operationId}}};if(op.requestType==='cancel')body.status='cancelled';else{body.start={dateTime:op.newStartUTC,timeZone:config.timezone};body.end={dateTime:new Date(Date.parse(op.newStartUTC)+config.duration*60000).toISOString(),timeZone:config.timezone}}
 try{boCalendar_(config,'patch',lead.eventId,body,event.etag,{sendUpdates:'all',conferenceDataVersion:1})}catch(e){if(e.code==='BOOKING_VERSION_CONFLICT'){journal.sheet.getRange(row,5).setValue('rejected');journal.sheet.getRange(row,10).setValue(e.code);SpreadsheetApp.flush();throw e}return boPending_(op)}return boReconcile_(op,journal.sheet,row);
 }finally{lock.releaseLock()}}
function reconcileBookingOperation(operationId,token){const actor=boOwner_(token);if(!boUUID_(operationId))throw boError_('BOOKING_OPERATION_INVALID');const lock=LockService.getScriptLock();if(!lock.tryLock(1500))throw boError_('BOOKING_BUSY');try{const journal=boJournal_(),index=journal.rows.findIndex(r=>r[0]===operationId);if(index<0)throw boError_('BOOKING_OPERATION_NOT_FOUND');const record=journal.rows[index];if(record[5]!==actor.email)throw boError_('ADMIN_FORBIDDEN');if(record[4]==='completed')return {...JSON.parse(record[9]),historical:true};if(record[4]==='rejected')return {ok:false,status:'rejected',code:record[9]};return boReconcile_(JSON.parse(record[8]),journal.sheet,index+2)}finally{lock.releaseLock()}}
