// Add to the Apps Script project BOUND to your Leads Google Sheet. No API keys needed.
function onOpen(){SpreadsheetApp.getUi().createMenu('Flow Leads').addItem('Open lead workspace','openLeadsDesk').addToUi()}
function openLeadsDesk(){SpreadsheetApp.getUi().showModelessDialog(HtmlService.createHtmlOutputFromFile('LeadsDesk').setWidth(1100).setHeight(760),'Flow · Leads')}
function deskSheet_(){const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Leads');if(!sh)throw Error('Leads tab not found.');return sh}
function deskPlain_(v){return String(v==null?'':v).replace(/^'(?=[=+@\-\t\r])/,'')}
function getLeadsDeskData(){const sh=deskSheet_(),last=sh.getLastRow();if(last<2)return [];const count=Math.min(200,last-1),width=Math.min(sh.getLastColumn(),18);return sh.getRange(last-count+1,1,count,width).getDisplayValues().reverse().map(r=>({reference:r[0],received:r[1],status:r[2],name:deskPlain_(r[3]),email:deskPlain_(r[4]),phone:deskPlain_(r[5]),company:deskPlain_(r[6]),services:deskPlain_(r[7]),notes:deskPlain_(r[9]),timezone:r[10]||'',call:r[11]||'',notification:r[14]||'',meet:r[16]||''}))}
function getLeadsDeskBrief(reference){if(!/^HADI-[a-f0-9-]{36}$/i.test(reference||''))throw Error('Invalid reference.');const sh=deskSheet_(),found=sh.getRange('A:A').createTextFinder(reference).matchEntireCell(true).findNext();if(!found)throw Error('Lead not found.');const raw=deskPlain_(sh.getRange(found.getRow(),9).getValue());let data;try{data=JSON.parse(raw)}catch(e){return 'No structured brief is available.'}return JSON.stringify(data._consultation?.brief||data,null,2).slice(0,40000)}
