// Bound Google Sheet control center. No web app or public endpoint.
const CC_KINDS=['knowledge','faq','personality','voice','crm','appointment','provider','project','site','caseStudy','skills','runtimePolicy','questionTree'];
function ccActor_(write=false,publish=false){const email=Session.getActiveUser().getEmail().trim().toLowerCase();let roles;try{roles=JSON.parse(PropertiesService.getScriptProperties().getProperty('ADMIN_ROLES')||'{}')}catch(e){throw Error('ADMIN_CONFIGURATION')}const role=roles[email];if(!email||!['owner','editor','viewer'].includes(role))throw Error('ADMIN_UNAUTHORIZED');if(write&&role==='viewer'||publish&&role!=='owner')throw Error('ADMIN_FORBIDDEN');return {email,role}}
function ccToken_(){const actor=ccActor_();let token=CacheService.getUserCache().get('cc-csrf');if(!token){token=Utilities.getUuid()+Utilities.getUuid();CacheService.getUserCache().put('cc-csrf',token,1800)}return {actor,token}}
function ccGuard_(token,publish=false){const actor=ccActor_(true,publish);if(typeof token!=='string'||!token||CacheService.getUserCache().get('cc-csrf')!==token)throw Error('ADMIN_SESSION_EXPIRED');return actor}
function openControlCenter(){ccActor_();SpreadsheetApp.getUi().showModelessDialog(HtmlService.createHtmlOutputFromFile('ControlCenter').setWidth(1200).setHeight(850),'Portfolio Business Control Center')}
function ccRows_(){const sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('ControlCenterRecords');if(!sheet||sheet.getLastRow()<2)return [];if(sheet.getLastRow()>2001)throw Error('ADMIN_ARCHIVE_REQUIRED');return sheet.getRange(2,1,sheet.getLastRow()-1,9).getValues()}
function ccVisible_(kind,data){const keys={skills:['enabled'],runtimePolicy:['contextChars','outputTokens','providerPriorities'],questionTree:['serviceId','questions'],caseStudy:["slug", "title", "deck", "category", "accent", "client", "services", "intro", "decision", "system", "design_copy", "goals", "deliverables", "sections", "link", "hero", "hero_width", "hero_height", "images", "seo_title", "seo_description", "replacements"],project:['slug','title','deck','category','intro','seo_title','seo_description','hero'],site:['email','phone','linkedin','behance','instagram','facebook'],knowledge:['title','category','parent','content','source','visibility'],faq:['question','answer','category','service','priority','alternatives'],personality:['name','welcome','style','formality','responseLength','languages'],voice:['enabled','voiceId','language','rate','pitch','confirmTranscript'],crm:['reference','stage','notes','tags','followUp'],appointment:['reference','requestType','newStartUTC','timezone','reason'],provider:['title','providerType','modelId','baseUrl','capabilities','priority','timeoutSeconds','outputTokens','dailyQuota','enabled']}[kind];if(!keys||!data||typeof data!=='object'||Array.isArray(data))throw Error('ADMIN_RECORD_INVALID');return Object.fromEntries(keys.filter(k=>Object.prototype.hasOwnProperty.call(data,k)).map(k=>[k,data[k]]))}
function ccLatest_(rows){const out=Object.create(null);for(const r of rows)out[r[0]]={id:r[0],kind:r[1],version:Number(r[2]),status:r[3],data:ccVisible_(r[1],JSON.parse(r[4])),actor:r[5],updated:r[6]};return out}
function ccApproved_(rows){const active=Object.create(null);for(const row of rows){if(row[3]==='published')active[row[0]]=ccLatest_([row])[row[0]];else if(row[3]==='archived')delete active[row[0]]}return Object.values(active)}
function getControlCenter(){const session=ccToken_(),rows=ccRows_(),records=Object.values(ccLatest_(rows));return {...session,records,approved:ccApproved_(rows),capabilities:{publicPublishing:false,providerCredentials:false,externalTests:false},notice:'Changes are stored in this private workspace. Public website publishing and external actions are disconnected.'}}
function ccText_(v,max,required=false){if(typeof v!=='string'||v.length>max||required&&!v.trim())throw Error('ADMIN_VALIDATION');return v.trim()}
function ccFields_(value,allowed){if(!value||typeof value!=='object'||Array.isArray(value)||Object.keys(value).some(k=>!allowed.includes(k)))throw Error('ADMIN_VALIDATION')}
function ccLead_(reference){if(typeof reference!=='string'||!/^HADI-[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(reference))throw Error('ADMIN_LEAD_REFERENCE');const sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Leads');if(!sheet||!sheet.getRange('A:A').createTextFinder(reference).matchEntireCell(true).findNext())throw Error('ADMIN_LEAD_NOT_FOUND')}
function ccValidate_(kind,data){
 if(kind==='knowledge'){ccFields_(data,['title','category','parent','content','source','visibility']);for(const k of ['title','category','content','source','parent'])ccText_(data[k]??'',k==='content'?12000:k==='parent'?64:250,['title','content','source'].includes(k));if(!['public','private'].includes(data.visibility))throw Error('ADMIN_VALIDATION');if(data.source&&!/^(https:\/\/|\/)/.test(data.source))throw Error('ADMIN_VALIDATION')}
 else if(kind==='faq'){ccFields_(data,['question','answer','category','service','priority','alternatives']);ccText_(data.question,250,true);ccText_(data.answer,2000,true);ccText_(data.category||'',100);if(!['','branding','design','social','commerce','app','landing'].includes(data.service||''))throw Error('ADMIN_VALIDATION');if(!Number.isInteger(data.priority)||data.priority<0||data.priority>100||!Array.isArray(data.alternatives)||data.alternatives.length>10||data.alternatives.some(x=>typeof x!=='string'||x.length>250))throw Error('ADMIN_VALIDATION')}
 else if(kind==='personality'){ccFields_(data,['name','welcome','style','formality','responseLength','languages']);ccText_(data.name,80,true);ccText_(data.welcome,500,true);if(!['consultative','concise','friendly'].includes(data.style)||!['professional','conversational'].includes(data.formality)||!['short','balanced'].includes(data.responseLength)||!Array.isArray(data.languages)||!data.languages.length||data.languages.some(x=>!['en','ur'].includes(x)))throw Error('ADMIN_VALIDATION')}
 else if(kind==='voice'){ccFields_(data,['enabled','voiceId','language','rate','pitch','confirmTranscript']);if(typeof data.enabled!=='boolean'||typeof data.confirmTranscript!=='boolean'||!['en','ur'].includes(data.language)||!Number.isFinite(data.rate)||data.rate<0.5||data.rate>2||!Number.isFinite(data.pitch)||data.pitch<0||data.pitch>2)throw Error('ADMIN_VALIDATION');ccText_(data.voiceId||'',200)}
 else if(kind==='crm'){ccFields_(data,['reference','stage','notes','tags','followUp']);ccLead_(data.reference);if(!['New','Contacted','Qualified','Proposal','Negotiation','Won','Lost'].includes(data.stage))throw Error('ADMIN_VALIDATION');ccText_(data.notes||'',5000);if(!Array.isArray(data.tags)||data.tags.length>20||data.tags.some(t=>typeof t!=='string'||t.length>50)||data.followUp&&(!/^\d{4}-\d{2}-\d{2}$/.test(data.followUp)||!Number.isFinite(Date.parse(data.followUp))))throw Error('ADMIN_VALIDATION')}
 else if(kind==='appointment'){ccFields_(data,['reference','requestType','newStartUTC','timezone','reason']);ccLead_(data.reference);ccText_(data.reason,2000,true);if(!['cancel','reschedule'].includes(data.requestType))throw Error('ADMIN_VALIDATION');if(data.requestType==='reschedule'){if(typeof data.newStartUTC!=='string'||!data.newStartUTC.endsWith('Z')||!Number.isFinite(Date.parse(data.newStartUTC))||Date.parse(data.newStartUTC)<=Date.now())throw Error('ADMIN_VALIDATION');ccText_(data.timezone,80,true);try{Utilities.formatDate(new Date(),data.timezone,'yyyy-MM-dd')}catch(e){throw Error('ADMIN_VALIDATION')}}}
 else if(kind==='provider'){ccFields_(data,['title','providerType','modelId','baseUrl','capabilities','priority','timeoutSeconds','outputTokens','dailyQuota','enabled']);ccText_(data.title,100,true);ccText_(data.modelId,150,true);if(!['gemini','groq','openrouter','compatible'].includes(data.providerType)||data.enabled!==false||!/^https:\/\/[a-z0-9.-]+(?::443)?(?:\/[a-zA-Z0-9_./-]*)?$/.test(data.baseUrl)||data.baseUrl.includes('..')||!Array.isArray(data.capabilities)||data.capabilities.some(c=>!['text','json','stream','vision'].includes(c))||!Number.isInteger(data.priority)||data.priority<0||data.priority>100||!Number.isInteger(data.timeoutSeconds)||data.timeoutSeconds<1||data.timeoutSeconds>30||!Number.isInteger(data.outputTokens)||data.outputTokens<1||data.outputTokens>2000||!Number.isInteger(data.dailyQuota)||data.dailyQuota<0)throw Error('ADMIN_PROVIDER_CONFIGURATION_DISABLED_OR_INVALID')}
 else if(['skills','runtimePolicy','questionTree'].includes(kind)){try{validateRuntimeRecord_(kind,data)}catch{throw Error('ADMIN_RUNTIME_INVALID')}}
 else if(kind==='caseStudy'){ccValidateCase_(data)}
 else if(kind==='project'){ccFields_(data,['slug','title','deck','category','intro','seo_title','seo_description','hero']);if(!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(data.slug))throw Error('ADMIN_VALIDATION');for(const k of ['title','deck','category','intro','seo_title','seo_description'])ccText_(data[k],k==='intro'?5000:500,true);if(typeof data.hero!=='string'||!/^\/assets\/[a-zA-Z0-9_/-]+\.(webp|png|jpe?g)$/.test(data.hero))throw Error('ADMIN_MEDIA_REFERENCE')}
 else if(kind==='site'){ccFields_(data,['email','phone','linkedin','behance','instagram','facebook']);if(typeof data.email!=='string'||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email))throw Error('ADMIN_VALIDATION');ccText_(data.phone,40,true);for(const k of ['linkedin','behance','instagram','facebook'])if(typeof data[k]!=='string'||data[k].length>300||!/^https:\/\/[^\s@]+$/.test(data[k]))throw Error('ADMIN_VALIDATION')}
 else throw Error('ADMIN_UNSUPPORTED_KIND');
 if(JSON.stringify(data).length>(['caseStudy','questionTree'].includes(kind)?64000:16000))throw Error('ADMIN_VALIDATION');return data;
}
function saveControlCenter(command,token){
 if(!command||typeof command!=='object'||Array.isArray(command))throw Error('ADMIN_VALIDATION');ccFields_(command,['id','kind','expectedVersion','status','data','operationId','confirm']);const actor=ccGuard_(token,['published','archived'].includes(command.status));
 if(!CC_KINDS.includes(command.kind)||!['draft','published','archived'].includes(command.status)||typeof command.id!=='string'||!/^[a-z][a-z0-9_-]{2,63}$/.test(command.id)||!Number.isInteger(command.expectedVersion)||command.expectedVersion<0||typeof command.operationId!=='string'||!/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(command.operationId))throw Error('ADMIN_VALIDATION');if(['published','archived'].includes(command.status)&&command.confirm!==true)throw Error('ADMIN_CONFIRMATION_REQUIRED');ccValidate_(command.kind,command.data);
 const lock=LockService.getDocumentLock();if(!lock.tryLock(1500))throw Error('ADMIN_BUSY');try{
 const rows=ccRows_(),hash=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify(command)).map(b=>(b&255).toString(16).padStart(2,'0')).join('');const prior=rows.find(r=>r[7]===command.operationId);if(prior){if(prior[8]!==hash||prior[5]!==actor.email)throw Error('ADMIN_OPERATION_MISMATCH');return {id:prior[0],version:Number(prior[2]),replayed:true}}
 if(rows.filter(r=>r[5]===actor.email&&Date.parse(r[6])>Date.now()-60000).length>=30)throw Error('ADMIN_RATE_LIMIT');const latest=ccLatest_(rows),old=latest[command.id];if((old?.version||0)!==command.expectedVersion)throw Error('ADMIN_VERSION_CONFLICT');if(old&&old.kind!==command.kind)throw Error('ADMIN_VALIDATION');if(old&&old.kind==='caseStudy'&&old.data.slug!==command.data.slug)throw Error('ADMIN_ROUTE_IMMUTABLE');if(command.status==='published'&&['personality','voice','site','skills','runtimePolicy'].includes(command.kind)&&ccApproved_(rows).some(r=>r.kind===command.kind&&r.id!==command.id))throw Error('ADMIN_SINGLETON_CONFLICT');if(command.status==='published'&&command.kind==='questionTree'&&ccApproved_(rows).some(r=>r.kind==='questionTree'&&r.data.serviceId===command.data.serviceId&&r.id!==command.id))throw Error('ADMIN_SINGLETON_CONFLICT');if(command.kind==='knowledge'){let parent=command.data.parent||'',seen=new Set([command.id]);while(parent){if(seen.has(parent))throw Error('ADMIN_HIERARCHY_CYCLE');seen.add(parent);const node=latest[parent];if(!node||node.kind!=='knowledge'||node.status==='archived')throw Error('ADMIN_PARENT_MISSING');if(command.status==='published'&&command.data.visibility==='public'&&(node.status!=='published'||node.data.visibility!=='public'))throw Error('ADMIN_PARENT_NOT_PUBLIC');parent=node.data.parent||''}}
 const ss=SpreadsheetApp.getActiveSpreadsheet();let sheet=ss.getSheetByName('ControlCenterRecords');if(!sheet){sheet=ss.insertSheet('ControlCenterRecords');sheet.appendRow(['ID','Kind','Version','Status','JSON','Actor','Updated UTC','Operation ID','Request hash'])}
 if(rows.length>=2000)throw Error('ADMIN_ARCHIVE_REQUIRED');const version=command.expectedVersion+1;sheet.appendRow([command.id,command.kind,version,command.status,JSON.stringify(command.data),actor.email,new Date().toISOString(),command.operationId,hash]);SpreadsheetApp.flush();return {id:command.id,version,status:command.status,publicPublishing:false};
 }finally{lock.releaseLock()}
}
function getControlCenterReport(){ccActor_();const records=Object.values(ccLatest_(ccRows_())),counts={};for(const r of records)counts[r.kind]=(counts[r.kind]||0)+1;return {source:'ControlCenterRecords latest revisions',generatedAt:new Date().toISOString(),recordCounts:counts,totalRecords:records.length,analyticsConnected:false,rows:records.map(r=>({id:r.id,kind:r.kind,version:r.version,status:r.status,updated:r.updated}))}}
function exportApprovedSeraConfig(token){ccGuard_(token,true);const approved=ccApproved_(ccRows_()),byId=Object.fromEntries(approved.map(r=>[r.id,r])),records=[];for(const record of approved){if(!['knowledge','faq','personality','voice','skills','runtimePolicy','questionTree'].includes(record.kind))continue;if(record.kind==='knowledge'){if(record.data.visibility!=='public')continue;let parent=record.data.parent||'',seen=new Set([record.id]),safe=true;while(parent){if(seen.has(parent))throw Error('ADMIN_HIERARCHY_CYCLE');seen.add(parent);const node=byId[parent];if(!node||node.kind!=='knowledge'||node.data.visibility!=='public'){safe=false;break}parent=node.data.parent||''}if(!safe)continue}ccValidate_(record.kind,record.data);records.push({id:record.id,kind:record.kind,version:record.version,data:record.data})}const result={schemaVersion:1,releaseId:Utilities.getUuid(),createdAt:new Date().toISOString(),records};if(JSON.stringify(result).length>131072)throw Error('ADMIN_EXPORT_TOO_LARGE');return result}

function exportApprovedCMS(token){ccGuard_(token,true);return {schemaVersion:1,releaseId:Utilities.getUuid(),createdAt:new Date().toISOString(),records:ccApproved_(ccRows_()).filter(r=>['project','site','caseStudy'].includes(r.kind)).map(r=>({id:r.id,kind:r.kind,version:r.version,data:r.data}))}}
